__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.DS_Store

# Raw and derived data pulls. The manifest (snapshots/manifest.json) is the
# artefact that gets committed: it pins every source file by sha256, so a clone
# can reproduce the exact data version without carrying 300 MB of NOAA CSVs.
snapshots/*
!snapshots/manifest.json
!snapshots/.gitkeep

# Phase 4 ground truth: a partner's national record or an EM-DAT export. These
# are files somebody was *given* under terms that forbid redistribution, so
# they are pinned by sha256 (in the contract, as a criterion, and in the
# manifest) and the bytes stay here, ignored, for ever. `tools/build_site.py`
# refuses to pack anything under this directory for the same reason.
#
# The one exception is ours to publish: the EM-DAT admin-name crosswalk, which
# is a judgement a person wrote down about which geoBoundaries region an
# EM-DAT name means, and which has to be committed for a panel to be
# reproducible at all. It is re-included by its *exact* shape — two letters,
# the country code `emdat.crosswalk_path` builds — and not by the suffix: a
# partner file named `PARTNER_CONFIDENTIAL_emdat_regions.csv` would otherwise
# be re-included and committed by the next `git add -A`. `contracts.py` refuses
# a ground-truth basename of that shape for the same reason, so the guard sits
# on both sides of the boundary. A ground-truth file itself lives one level
# down, at `snapshots/records/<CC>/<basename>`, and git does not descend into
# an excluded directory, so it stays ignored.
!snapshots/records/
snapshots/records/*
!snapshots/records/??_emdat_regions.csv

# Rendered ledger dashboards: regenerated in under a second from the committed
# ledgers by `readiness dashboard --all`.
experiments/*/dashboard.html
experiments/index.html

# Phase 2 outputs. `readiness issue` and `readiness brief` write these from the
# committed ledgers and pinned data; a real run's files are committed
# deliberately (a brief cites an issued file by path), not swept in by a
# wildcard, so the trees carry only their README.
issued/*
!issued/README.md
briefs/*
!briefs/README.md

# Scratch registry and ledgers used while regenerating docs/media.
docs/.demo/

# The overview website's generated data: rebuilt from the repo's own artefacts
# (and the pinned snapshots, if present) by `make site`.
site/generated/

# Agent worktrees created by tooling during a session; never part of the repo.
.claude/worktrees/

# Phase 3. A facility record names a real building and its weaknesses; a gap
# report and its blinded rendering carry the same; a review record binds a
# named person's judgement to one of them. None of that belongs in a public
# repository, so the trees carry their README, the fictional example facility
# and nothing else. A case study is different: it is a published investigation,
# added deliberately, and lives in plans/case-studies/.
# Everything under each tree, at any depth and whatever the extension: a
# record in a subdirectory, a roster as .md or a .JSON on a case-insensitive
# filesystem is exactly the file that must not be committed by accident.
plans/facilities/**
!plans/facilities/README.md
!plans/facilities/example-rural-hospital.json
plans/reports/**
!plans/reports/README.md
plans/reviews/**
!plans/reviews/README.md
