__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.DS_Store

# Raw and derived data pulls. The manifest (snapshots/manifest.json) is the
# artefact that gets committed: it pins every source file by sha256, so a clone
# can reproduce the exact data version without carrying 300 MB of NOAA CSVs.
snapshots/*
!snapshots/manifest.json
!snapshots/.gitkeep

# Rendered ledger dashboards: regenerated in under a second from the committed
# ledgers by `readiness dashboard --all`.
experiments/*/dashboard.html
experiments/index.html

# Phase 2 outputs. `readiness issue` and `readiness brief` write these from the
# committed ledgers and pinned data; a real run's files are committed
# deliberately (a brief cites an issued file by path), not swept in by a
# wildcard, so the trees carry only their README.
issued/*
!issued/README.md
briefs/*
!briefs/README.md

# Scratch registry and ledgers used while regenerating docs/media.
docs/.demo/

# The overview website's generated data: rebuilt from the repo's own artefacts
# (and the pinned snapshots, if present) by `make site`.
site/generated/

# Agent worktrees created by tooling during a session; never part of the repo.
.claude/worktrees/

# Phase 3. A facility record names a real building and its weaknesses; a gap
# report and its blinded rendering carry the same; a review record binds a
# named person's judgement to one of them. None of that belongs in a public
# repository, so the trees carry their README, the fictional example facility
# and nothing else. A case study is different: it is a published investigation,
# added deliberately, and lives in plans/case-studies/.
plans/facilities/*.json
!plans/facilities/example-rural-hospital.json
plans/reports/*
!plans/reports/README.md
plans/reviews/*.json
