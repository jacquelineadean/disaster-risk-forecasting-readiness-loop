{
  "name": "winter-storm-us",
  "version": "1.0.0",
  "description": "Damaging winter storms, every US county, monthly; zone events expanded.",
  "hazard": "winter_storm",
  "event_types": [
    "Winter Storm",
    "Blizzard",
    "Ice Storm",
    "Heavy Snow",
    "Lake-Effect Snow",
    "Sleet"
  ],
  "scope": {
    "country": "US",
    "states": []
  },
  "period": "month",
  "damaging": {
    "property_usd_min": 10000.0,
    "count_casualties": true
  },
  "zone_policy": "expand",
  "splits": {
    "train": [
      1996,
      2015
    ],
    "validate": [
      2016,
      2020
    ],
    "test": [
      2021,
      2025
    ]
  },
  "test_touch_budget": 1,
  "reference_model": "climatology-pooled",
  "thresholds": {
    "min_brier_skill_score": 0.0,
    "reliability_tolerance_pp": 0.05,
    "reliability_min_bin_count": 30,
    "min_auc": 0.7,
    "n_reliability_bins": 10
  }
}
